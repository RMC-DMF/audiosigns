---
// Flat illustration of a sign speaking in a setting. Files live in /public/images/scenes/<slug>-{800,1500}.{webp,jpg}, all 3:2.
interface Props { slug: string; alt: string; sizes?: string; eager?: boolean; class?: string }
const { slug, alt, sizes = '(min-width: 1280px) 1200px, 100vw', eager = false, class: cls } = Astro.props;
const base = `/images/scenes/${slug}`;
---
<picture class:list={['scene', cls]}>
  <source type="image/webp" srcset={`${base}-800.webp 800w, ${base}-1500.webp 1500w`} sizes={sizes}>
  <img src={`${base}-1500.jpg`} srcset={`${base}-800.jpg 800w, ${base}-1500.jpg 1500w`} sizes={sizes} width="1500" height="1000" alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async">
</picture>
<style>
  .scene { display: block; }
  .scene img { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>

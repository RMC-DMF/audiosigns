---
import { url, cta } from '../lib/site';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const steps = [
  ['Scoping call', 'The hazard, the location, who passes it and in which languages. Fifteen minutes.'],
  ['Script', 'We write the message for that spot. You approve the words before anything is recorded.'],
  ['Artwork and recording', 'Your branding on the board. The message recorded in the languages your site uses, sent to you to hear before it’s built.'],
  ['Build', 'Tooled and assembled to order in Ripon, North Yorkshire.'],
  ['Delivery', 'Days from sign-off for a single sign; a little longer for larger orders. We ship anywhere.'],
];
---
<section id="start" class="section">
  <div class="wrap stack stack--lg">
    <div class="stack" style="max-width: 760px;">
      <p class="eyebrow">How it works</p>
      <h2 class="h2">Start with one sign. We build it around the hazard.</h2>
      {!compact && <p class="body-lg">Nothing here comes off a shelf. Each AudioSign is scripted, recorded, printed and built for the place it will stand, which is why one sign is the right way to start.</p>}
    </div>
    <ol class="rule-list grid-5">
      {steps.map(([h, p], i) => (
        <li>
          <span class="num">{i + 1}</span>
          <h3 class="h3" style="font-size: 20px;">{h}</h3>
          <p class="small" style="font-size: 15px; color: var(--text-2);">{p}</p>
        </li>
      ))}
    </ol>
    <div class="process__cta">
      <a href={url(cta.href)} class="btn btn--ink">{cta.label}</a>
      <span class="small">Priced per order, with volume pricing for multi-site rollouts. No installer, no wiring: it arrives configured.</span>
    </div>
  </div>
</section>
<style>
  .process__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; }
  @media (max-width: 900px) { .rule-list.grid-5 { grid-template-columns: 1fr; } }
</style>
